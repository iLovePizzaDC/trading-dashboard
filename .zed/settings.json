{
	"languages": {
		"TypeScript": {
			"language_servers": ["typescript-language-server", "!vtsls", "..."],
			"formatter": {
				"external": {
					"command": "npx",
					"arguments": ["prettier", "--stdin-filepath", "{buffer_path}"],
				},
			},
			"format_on_save": "on",
			"code_actions_on_format": {
				"source.addMissingImports.ts": true,
				"source.organizeImports.ts": true,
			},
		},
		"TSX": {
			"language_servers": ["typescript-language-server", "!vtsls", "..."],
			"formatter": {
				"external": {
					"command": "npx",
					"arguments": ["prettier", "--stdin-filepath", "{buffer_path}"],
				},
			},
			"format_on_save": "on",
			"code_actions_on_format": {
				"source.addMissingImports.ts": true,
				"source.organizeImports.ts": true,
			},
		},
	},
	"lsp": {
		"eslint": {
			"settings": {
				"workingDirectory": { "mode": "auto" },
			},
		},
	},
}
